          "STEWARD"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "vic123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "VOTER"
      ]
    },
    {
      "username": "gina",
      "enabled": true,
      "email": "gina@demo.invest",
